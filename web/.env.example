# Copy to .env.local for development, and set the same two variables in Vercel
# (Project > Settings > Environment Variables). Both are public by design:
# Row Level Security in supabase/migrations restricts what the anon key can do.
# NEVER put the service_role key in a VITE_ variable — it would ship to every browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
